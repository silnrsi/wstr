---
import { markdownToHtml } from 'satteri';

const { text } = Astro.props;
const { html } = markdownToHtml(text)
---
<div class="captiontext sl-flex" set:html={html} />
<style>
    .captiontext {
        font-size: var(--sl-text-xs);
        font-style: italic;
        color: var(--sl-color-gray-3);
        margin-top: 0.5rem;
    }
</style>
