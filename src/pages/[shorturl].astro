---
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
    const entries = await getCollection('docs', (entry) => ('shorturl' in entry.data));

    return entries.map((entry) => ({
        params: { shorturl: (entry.data.shorturl?.toLowerCase()) },
        props: { url: '/' + entry.id },
    }));
}

const { url } = Astro.props
---
<!doctype html>
<html>
    <head>
        <noscript><meta http-equiv="refresh" content={`0;url=${url}`}/></noscript>
        <meta name="robots" content="noindex"/>
        <link rel="canonical" href={url}/>
        <script is:inline define:vars={{url}}>window.location.href = `${url}/${window.location.search}`</script>
    </head>
</html>