---
// ScriptList component: display a list of scripts, derived from the main script pages.

import { getCollection } from 'astro:content';
const scrDocs = await getCollection('scriptdocs');

const { nonunicode = "False"} = Astro.props;

function isNonUnicode(key: string): boolean {
	return (key.substring(0,2) == "x-");
}

function isSpecialZCode(key: string): boolean {
	const c = key.substring(0,4);
	return (c == "Zxxx" || c == "Zyyy" || c == "Zzzz" || c == "Zinh");
}

let sortedDocs = scrDocs.sort((a, b) => (a.data.scrpropsortname ?? '').localeCompare(b.data.scrpropsortname ?? ''));

---

<div>
	<table>
	<thead>
	{nonunicode == "True" ?
		<tr>Name</th>
		:
		<tr>
			<th>ISO</th>
			<th>Name</th>
			<th>Region</th>
			<th>Type</th>
			<th>Direction</th>
			<th>Status</th>
		</tr>
	}
	</thead>
	<tbody>
		{sortedDocs.map(scriptArt => {
			if (isNonUnicode(scriptArt.data.scrpropcode ?? '')) {
				{if (nonunicode == "True") {
					return  (
					<tr>
						<td>{scriptArt.data.scrpropcode}</td>
						<td><a href={`/scrlang/scripts/${(scriptArt.data.scrpropcode ?? '').toLowerCase()}`}>{scriptArt.data.scrpropname}</a></td>
						<td>{scriptArt.data.scrpropregion}</td>
						<td>{scriptArt.data.scrproptype}</td>
						<td>{scriptArt.data.scrpropdirection}</td>
						<td>{scriptArt.data.scrpropstatus}</td>
					</tr>
					);
				}}
				return null;
			} else {
				{if (isSpecialZCode(scriptArt.data.scrpropcode ?? '')) { return null; }}
				{if (nonunicode == "True") { return null; }}
				return (
					<tr>
						<td>{scriptArt.data.scrpropcode}</td>
						<td><a href={`/scrlang/scripts/${(scriptArt.data.scrpropcode ?? '').toLowerCase()}`}>{scriptArt.data.scrpropname}</a></td>
						<td>{scriptArt.data.scrpropregion}</td>
						<td>{scriptArt.data.scrproptype}</td>
						<td>{scriptArt.data.scrpropdirection}</td>
						<td>{scriptArt.data.scrpropstatus}</td>
					</tr>
				);
			}
			return null;
		})}
	</tbody>
	</table>
</div>

<style>
</style>

