---
// WsGraphemes component: display a table of graphemes and phonograms used by a given writing system.
// Parameters:
//     script: wsCode - WS code, eg. de-Latn, fub-Arab

import Character from './Character.astro';

import wsgData from '../data/ws-graphemes.json';

import phonemeData from '../data/phonemes.json';

//const pData = phonemeData;

function phonemeSymbol(key: string): string {
	return phonemeData[key]?.symbol ?? "";
}

function phonemeLabel(key: string): string {
	return phonemeData[key]?.label ?? "";
}

function phonemeSlug(key: string): string {

	let result = phonemeData[key]?.slug ?? key;

	const hpos = result.indexOf("#");
	let anchor = "";
	if (hpos > -1) {
		anchor = result.substring(hpos);
		result = result.substring(0, hpos);
	}

	if (result.substring(0, 4) == 'diph') {
		result = result.replace("-lngth", "");
		
	} else if (result.substring(0, 4) == "dart") {
		// NOT YET IMPLEMENTED
	
	} else if (result.substring(0, 4) == "tone") {
	
	} else if (result.substring(0, 3) == "vwl") {
		// remove modification, eg, '-short'
		if (result.substring(0, 9) == "vwl-ce-ap") {
			result = "vwl-ce-ap";
		} else {
			result = result.substring(0, 13);	// eg, vwl-fr-op-rnd
		}

	} else if (result.substring(0, 4) == "cons") {  // eg, cons-null

	} else {   // consonant
		// remove modification, eg, '-gemin'
		let place = result.substring(0, 3);
		if (place == "stp" || place == "aff" || place == "fri" || place == "tap") {
			result = result.substring(0, 10);	// eg, stp-bil-vl
		} else {
			result = result.substring(0, 7);	// eg, nas-alv
		}
	}

	result = phonemeData[result]?.slug ?? result;	// eg, nas-den -> nas-alv

	result = result.replace("+", "__");
	result = result + anchor;
	console.log(key + " >> " + result);
	return result;
}

function isDblArt(key: string): boolean {
	return key.indexOf("dart") == 0;
}

function dblArtKey(key: string, i: integer): string {
	const kmod = key.replace("dart-", "");
	const keys = kmod.split("+");
	let result = keys[i];
	//console.log(key + '[' + i + '] = ' + result);
	return result;
}

function seqLength(key: string): string {
	if ( key.substring(0, 4) == "diph") {
		return 1;
	} else if ( isDblArt(key) ) {
		return 1;
	} else {
		return key.split("+").length;
	}
}

function seqKey(key: string, i: integer): string {
	const seqKeys = key.split("+");
	let result = seqKeys[i];
	//console.log(key + '[' + i + '] = ' + result);
	return result;
}

function seqSymbol(key: string, i: integer): string {
	const seqKeys = key.split("+");
	return phonemeSymbol(seqKeys[i]);
}

const { wsCode } = Astro.props;

const allPhonograms = wsgData["phonograms"];
//const allCount = allPhonograms ? allPhonograms.length : 0;

//const intros = wsgData["intros"];
//const intro = intros[wsCode];

let wsPhonograms = allPhonograms.filter(pg => pg.ws === wsCode);
let pgCount = wsPhonograms ? wsPhonograms.length : 0;

//console.log('# phonograms = ' + pgCount);

---

<div>
<table>
	<thead>
		<tr>
			<th>Grapheme</th>
			<th>USV</th>
			<th>Phoneme</th>
			<th>Status</th>
			<th>Example</th>
			<th>Notes</th>
		</tr>
	</thead>

	<tbody>
		{wsPhonograms.map((wsp) =>
			<tr> 
				<td>
					&lt;{wsp.chars.map((ch) => <Character usv={ch} options="char" />)}&gt;
				</td>
				<td>
					{wsp.chars.map((ch) =>
						<span>{ch} </span>
					)}	
				</td>
				<td>
				{seqLength(wsp.phoneme) > 1 ? 
					<span>/{seqSymbol(wsp.phoneme, 0)}{seqSymbol(wsp.phoneme, 1)}/ =<br/> 
					<a href={`/scrlang/phonemes/${(phonemeSlug(seqKey(wsp.phoneme,0)))}`} title={phonemeLabel(seqKey(wsp.phoneme,0))}>/{phonemeSymbol(seqKey(wsp.phoneme,0))}/</a>
					+
					<a href={`/scrlang/phonemes/${(phonemeSlug(seqKey(wsp.phoneme,1)))}`} title={phonemeLabel(seqKey(wsp.phoneme,1))}>/{phonemeSymbol(seqKey(wsp.phoneme,1))}/</a>
					</span>
					:
					<span>
						{isDblArt(wsp.phoneme) ? 
							<span>/{phonemeSymbol(wsp.phoneme)}/&nbsp;=<br/>
							<a href={`/scrlang/phonemes/${(phonemeSlug(dblArtKey(wsp.phoneme,0)))}#dart`} title={phonemeLabel(dblArtKey(wsp.phoneme,0))}>/{phonemeSymbol(dblArtKey(wsp.phoneme,0))}/</a>
							&nbsp;&nbsp;&#x0361;&nbsp;
							<a href={`/scrlang/phonemes/${(phonemeSlug(dblArtKey(wsp.phoneme,1)))}#dart`} title={phonemeLabel(dblArtKey(wsp.phoneme,1))}>/{phonemeSymbol(dblArtKey(wsp.phoneme,1))}/</a>
							</span> 
							:
							<a href={`/scrlang/phonemes/${(phonemeSlug(wsp.phoneme))}`} title={phonemeLabel(wsp.phoneme)}>/{phonemeSymbol(wsp.phoneme)}/</a>	}
					</span>
				}
				</td>
				<td>{wsp.status}</td>
				<td set:html={wsp.example} />
				<td set:html={wsp.notes} />
			</tr>
		)}
	</tbody>

</table>
</div>
